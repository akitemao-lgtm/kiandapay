# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chave pública (publishable/anon). Segura no browser: o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta (secret/service_role). SÓ no servidor; nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usado nos links enviados ao cliente)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo para /api/cron (expirar pedidos, lembretes). Gerar: openssl rand -hex 32
CRON_SECRET=

# --- Mensagens ao cliente e ao administrador ---
# Provedores: SMS e WhatsApp = twilio | log ; Email = resend | log
# "log" apenas escreve na consola do servidor. Sem provedor, a mensagem fica como falhada.
SMS_PROVIDER=
WHATSAPP_PROVIDER=
EMAIL_PROVIDER=

# Twilio (SMS e/ou WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=          # ex.: +1XXXXXXXXXX ou ID alfanumérico aprovado
TWILIO_WHATSAPP_FROM=     # ex.: +1XXXXXXXXXX (número WhatsApp aprovado)

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=               # ex.: Loja <pedidos@o-seu-dominio.com>

# --- Meta (Pixel + API de Conversões) ---
# Chave para cifrar os tokens da API de Conversões guardados na BD. Gerar: openssl rand -base64 32
# Se mudar esta chave, os tokens já guardados deixam de funcionar (volte a colá-los no painel).
META_TOKEN_ENCRYPTION_KEY=
# Versão da Graph API (opcional). Atualize quando o Meta descontinuar a atual.
META_GRAPH_VERSION=v27.0
